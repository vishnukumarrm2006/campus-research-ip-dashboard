{
  "name": "campus-research-ip-backend",
  "version": "1.0.0",
  "description": "Backend REST API for Automated Campus Research Project Lifecycle Management and Collaborative IP Filing Dashboard",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:schema": "node src/database/migrate.js --schema",
    "db:seed": "node src/database/migrate.js --seed",
    "db:migrate": "node src/database/migrate.js --all"
  },
  "keywords": [
    "research-lifecycle",
    "ip-filing",
    "express",
    "postgresql",
    "rbac"
  ],
  "author": "Campus Research Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
